  "groups": [
    {
      "name": "topdown",
      "suffix": "TOPDOWN",
      "events": ["0x0011", "0x0008", "0x1f21", "0x001b"],
      "event_headers": ["0x0011 (cycles)", "0x0008", "0x1f21", "0x001b"],
      "derived": [
        {"name": "retire", "number_format": "0.00%", "formula": "=IFERROR({0x0008}/(8*{0x0011}),\"\")"},
        {"name": "frontend_bound", "number_format": "0.00%", "formula": "=IFERROR({0x1f21}/(8*{0x0011}),\"\")"},
        {"name": "bad_spec", "number_format": "0.00%", "formula": "=IFERROR(({0x001b}-{0x0008})/(8*{0x0011}),\"\")"},
        {"name": "backend_bound", "number_format": "0.00%", "formula": "=IFERROR(1-{retire}-{frontend_bound}-{bad_spec},\"\")"}
      ]
    },
