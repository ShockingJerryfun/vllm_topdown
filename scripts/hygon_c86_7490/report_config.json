{
  "groups": [
    {
      "name": "topdown",
      "suffix": "TOPDOWN",
      "events": ["cycles", "instructions", "retired_uops", "dispatched_uops", "frontend_stall_any"],
      "event_headers": ["0x76", "0xc0", "0xc1", "0x03aa", "0x0487"],
      "semantic_headers": [
        "cycles",
        "instructions",
        "retired_uops",
        "dispatched_uops",
        "frontend_stall_any"
      ],
      "derived": [
        {"name": "IPC", "number_format": "0.00", "formula": "=IFERROR({instructions}/{cycles},\"\")"},
        {"name": "Retire", "number_format": "0.00%", "formula": "=IFERROR({retired_uops}/(6*{cycles}),\"\")"},
        {"name": "FrontendBound", "number_format": "0.00%", "formula": "=IFERROR({frontend_stall_any}/{cycles},\"\")"},
        {"name": "BadSpec", "number_format": "0.00%", "formula": "=IFERROR(MAX({dispatched_uops}-{retired_uops},0)/(6*{cycles}),\"\")"},
        {"name": "BackendBound", "number_format": "0.00%", "formula": "=IFERROR(1-{Retire}-{FrontendBound}-{BadSpec},\"\")"}
      ]
    },
    {
      "name": "branch",
      "suffix": "BRANCH",
      "events": ["instructions", "branches", "branch_misses"],
      "event_headers": ["0xc0", "0xc2", "0xc3"],
      "semantic_headers": ["instructions", "branches", "branch_misses"],
      "derived": [
        {"name": "br missrate", "number_format": "0.00%", "formula": "=IFERROR({branch_misses}/{branches},\"\")"},
        {"name": "br mpki", "number_format": "0.00", "formula": "=IFERROR({branch_misses}/{instructions}*1000,\"\")"}
      ]
    },
    {
      "name": "spec_ls",
      "suffix": "SPEC_LS",
      "events": ["dispatched_uops", "load_ops", "store_ops", "load_store_ops", "branches"],
      "event_headers": ["0x03aa", "0x0129", "0x0229", "0x0429", "0xc2"],
      "semantic_headers": [
        "dispatched_uops",
        "load_ops",
        "store_ops",
        "load_store_ops",
        "branches"
      ],
      "derived": [
        {"name": "ld_spec", "number_format": "0.00%", "formula": "=IFERROR({load_ops}/{dispatched_uops},\"\")"},
        {"name": "st_spec", "number_format": "0.00%", "formula": "=IFERROR(({store_ops}+{load_store_ops})/{dispatched_uops},\"\")"},
        {"name": "branch_spec", "number_format": "0.00%", "formula": "=IFERROR({branches}/{dispatched_uops},\"\")"}
      ]
    },
    {
      "name": "spec_ase",
      "suffix": "SPEC_ASE",
      "events": ["dispatched_uops", "fpu_spec_uops"],
      "event_headers": ["0x03aa", "0x0f00"],
      "semantic_headers": [
        "dispatched_uops",
        "fpu_spec_uops"
      ],
      "derived": [
        {"name": "ase_spec", "number_format": "0.00%", "formula": "=IFERROR({fpu_spec_uops}/{dispatched_uops},\"\")"}
      ]
    },
    {
      "name": "icache",
      "suffix": "ICACHE",
      "events": ["instructions", "l1i_fetch_windows", "l1i_miss_windows", "l2i_accesses", "l2i_misses"],
      "event_headers": ["0xc0", "0x80", "0x81", "0x0764", "0x0164"],
      "semantic_headers": ["instructions", "l1i_fetch_windows", "l1i_miss_windows", "l2i_accesses", "l2i_misses"],
      "derived": [
        {"name": "l1i missrate", "number_format": "0.00%", "formula": "=IFERROR({l1i_miss_windows}/{l1i_fetch_windows},\"\")"},
        {"name": "l1i mpki", "number_format": "0.00", "formula": "=IFERROR({l1i_miss_windows}/{instructions}*1000,\"\")"},
        {"name": "l2i missrate", "number_format": "0.00%", "formula": "=IFERROR({l2i_misses}/{l2i_accesses},\"\")"},
        {"name": "l2i mpki", "number_format": "0.00", "formula": "=IFERROR({l2i_misses}/{instructions}*1000,\"\")"}
      ]
    },
    {
      "name": "dcache",
      "suffix": "DCACHE",
      "events": ["instructions", "ls_ops", "l1d_miss_proxy", "l2d_misses", "l2d_hits"],
      "event_headers": ["0xc0", "0x0729", "0xc860", "0x0864", "0xf064"],
      "semantic_headers": [
        "instructions",
        "ls_ops",
        "l1d_miss_proxy",
        "l2d_misses",
        "l2d_hits"
      ],
      "derived": [
        {"name": "l1d missrate", "number_format": "0.00%", "formula": "=IFERROR({l1d_miss_proxy}/{ls_ops},\"\")"},
        {"name": "l1d mpki", "number_format": "0.00", "formula": "=IFERROR({l1d_miss_proxy}/{instructions}*1000,\"\")"},
        {"name": "L2d missrate", "number_format": "0.00%", "formula": "=IFERROR({l2d_misses}/({l2d_hits}+{l2d_misses}),\"\")"},
        {"name": "L2d mpki", "number_format": "0.00", "formula": "=IFERROR({l2d_misses}/{instructions}*1000,\"\")"}
      ]
    },
    {
      "name": "tlb",
      "suffix": "TLB",
      "events": ["instructions", "ls_ops", "l1_dtlb_misses", "stlb_hits", "stlb_misses"],
      "event_headers": ["0xc0", "0x0729", "0xff45", "0x0f45", "0xf045"],
      "semantic_headers": [
        "instructions",
        "ls_ops",
        "l1_dtlb_misses",
        "stlb_hits",
        "stlb_misses"
      ],
      "derived": [
        {"name": "dtlb missrate", "number_format": "0.00%", "formula": "=IFERROR({l1_dtlb_misses}/{ls_ops},\"\")"},
        {"name": "dtlb mpki", "number_format": "0.00", "formula": "=IFERROR({l1_dtlb_misses}/{instructions}*1000,\"\")"},
        {"name": "stlb missrate", "number_format": "0.00%", "formula": "=IFERROR({stlb_misses}/({stlb_hits}+{stlb_misses}),\"\")"},
        {"name": "stlb mpki", "number_format": "0.00", "formula": "=IFERROR({stlb_misses}/{instructions}*1000,\"\")"}
      ]
    },
    {
      "name": "l3",
      "suffix": "L3",
      "events": ["l3_accesses", "l3_misses"],
      "event_headers": [
        "0xff04",
        "0x0106"
      ],
      "semantic_headers": [
        "l3_accesses",
        "l3_misses"
      ],
      "derived": [
        {"name": "L3 missrate", "number_format": "0.00%", "formula": "=IFERROR({l3_misses}/{l3_accesses},\"\")"}
      ]
    }
  ]
}
