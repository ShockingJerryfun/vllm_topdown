{
  "groups": [
    {
      "name": "base",
      "suffix": "BASE",
      "events": ["cycles", "instructions", "branches", "branch_misses", "retired_uops"],
      "derived": [
        {"name": "IPC", "number_format": "0.00", "formula": "=IFERROR({instructions}/{cycles},\"\")"},
        {"name": "CPI", "number_format": "0.00", "formula": "=IFERROR({cycles}/{instructions},\"\")"},
        {"name": "Branch MPKI", "number_format": "0.00", "formula": "=IFERROR({branch_misses}/{instructions}*1000,\"\")"},
        {"name": "Branch miss ratio", "number_format": "0.00%", "formula": "=IFERROR({branch_misses}/{branches},\"\")"},
        {"name": "Branches / inst", "number_format": "0.00", "formula": "=IFERROR({branches}/{instructions},\"\")"},
        {"name": "Retired uops / inst", "number_format": "0.00", "formula": "=IFERROR({retired_uops}/{instructions},\"\")"},
        {"name": "Retired uops / cycle", "number_format": "0.00", "formula": "=IFERROR({retired_uops}/{cycles},\"\")"}
      ]
    },
    {
      "name": "uops_ls",
      "suffix": "UOPS_LS",
      "events": ["cycles", "instructions", "dispatched_uops", "retired_uops", "ls_ops_dispatched"],
      "derived": [
        {"name": "Dispatched uops / inst", "number_format": "0.00", "formula": "=IFERROR({dispatched_uops}/{instructions},\"\")"},
        {"name": "Dispatched uops / cycle", "number_format": "0.00", "formula": "=IFERROR({dispatched_uops}/{cycles},\"\")"},
        {"name": "LS ops / inst", "number_format": "0.00", "formula": "=IFERROR({ls_ops_dispatched}/{instructions},\"\")"}
      ]
    },
    {
      "name": "frontend",
      "suffix": "FRONTEND",
      "events": ["cycles", "instructions", "ic_dq_empty", "ic_backpressure", "l1i_fetch_misses"],
      "derived": [
        {"name": "Frontend starvation ratio", "number_format": "0.00%", "formula": "=IFERROR({ic_dq_empty}/{cycles},\"\")"},
        {"name": "Downstream backpressure", "number_format": "0.00%", "formula": "=IFERROR({ic_backpressure}/{cycles},\"\")"},
        {"name": "L1I fetch MPKI", "number_format": "0.00", "formula": "=IFERROR({l1i_fetch_misses}/{instructions}*1000,\"\")"}
      ]
    },
    {
      "name": "backend",
      "suffix": "BACKEND",
      "events": ["cycles", "instructions", "retire_token_stalls", "agsq_token_stalls", "alu_token_stalls"],
      "derived": [
        {"name": "Retire resource pressure", "number_format": "0.00%", "formula": "=IFERROR({retire_token_stalls}/{cycles},\"\")"},
        {"name": "Address/LS pressure", "number_format": "0.00%", "formula": "=IFERROR({agsq_token_stalls}/{cycles},\"\")"},
        {"name": "ALU resource pressure", "number_format": "0.00%", "formula": "=IFERROR({alu_token_stalls}/{cycles},\"\")"}
      ]
    },
    {
      "name": "dcache",
      "suffix": "DCACHE",
      "events": ["instructions", "l1d_8byte_accesses", "l2_data_requests", "l2_data_misses", "l2_data_hits"],
      "derived": [
        {"name": "L1D accesses / inst", "number_format": "0.00", "formula": "=IFERROR({l1d_8byte_accesses}/{instructions},\"\")"},
        {"name": "L2 request MPKI", "number_format": "0.00", "formula": "=IFERROR({l2_data_requests}/{instructions}*1000,\"\")"},
        {"name": "L2 miss MPKI", "number_format": "0.00", "formula": "=IFERROR({l2_data_misses}/{instructions}*1000,\"\")"},
        {"name": "L2 hit ratio", "number_format": "0.00%", "formula": "=IFERROR({l2_data_hits}/({l2_data_hits}+{l2_data_misses}),\"\")"},
        {"name": "L2 miss ratio", "number_format": "0.00%", "formula": "=IFERROR({l2_data_misses}/({l2_data_hits}+{l2_data_misses}),\"\")"},
        {"name": "L2 coverage", "number_format": "0.00%", "formula": "=IFERROR(({l2_data_hits}+{l2_data_misses})/{l2_data_requests},\"\")"}
      ]
    },
    {
      "name": "dtlb",
      "suffix": "DTLB",
      "events": ["instructions", "l1_dtlb_misses", "dtlb_l2_hits", "dtlb_l2_misses", "data_page_walks"],
      "derived": [
        {"name": "DTLB MPKI", "number_format": "0.00", "formula": "=IFERROR({l1_dtlb_misses}/{instructions}*1000,\"\")"},
        {"name": "L2 TLB hit ratio", "number_format": "0.00%", "formula": "=IFERROR({dtlb_l2_hits}/({dtlb_l2_hits}+{dtlb_l2_misses}),\"\")"},
        {"name": "L2 TLB miss ratio", "number_format": "0.00%", "formula": "=IFERROR({dtlb_l2_misses}/({dtlb_l2_hits}+{dtlb_l2_misses}),\"\")"},
        {"name": "Page-walk MPKI", "number_format": "0.00", "formula": "=IFERROR({data_page_walks}/{instructions}*1000,\"\")"},
        {"name": "DTLB coverage", "number_format": "0.00%", "formula": "=IFERROR(({dtlb_l2_hits}+{dtlb_l2_misses})/{l1_dtlb_misses},\"\")"}
      ]
    }
  ]
}
