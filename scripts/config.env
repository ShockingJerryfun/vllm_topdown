# 当前执行的芯片目录：920b、950或hygon_c86_7490。
CHIP=920b

# 宿主机上的vLLM容器名称。
CONTAINER=qwen3_container_fj

# 仓库在宿主机和容器内的共同路径。
PROJECT=/home/fj/vllm_topdown

# 模型目录。
MODEL=/home/model/Qwen3-8B-Instruct

# vLLM可执行文件及其Python解释器。
VLLM_BIN=vllm
PYTHON_BIN=python3

# vLLM安装目录；留空时由Python自动查找。
VLLM_SITE=

# 运行记录中的vLLM完整版本，以及最终文件名中的版本和模型简称。
VLLM_VERSION=0.26.0
MODEL_SHORT=qwen3
VLLM_VERSION_SHORT=0.26

# 使用vLLM V2 model runner。
VLLM_USE_V2_MODEL_RUNNER=1

# 使用的GPU编号。
GPU_ID=0

# API服务使用的模型名、监听地址、端口和健康检查路径。
SERVED_MODEL=qwen3-8b
SERVER_HOST=127.0.0.1
PORT=18026
HEALTH_ENDPOINT=/health

# vLLM服务端参数。
BLOCK_SIZE=16
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=163840
TENSOR_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=1
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.8
PREFIX_CACHING_FLAG=--no-enable-prefix-caching
SERVER_SEED=0
SERVER_FLAGS="--async-scheduling"

# benchmark请求参数。
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
DATASET_NAME=random
RANDOM_INPUT_LEN=7000
RANDOM_OUTPUT_LEN=100
RANDOM_RANGE_RATIO=0
NUM_PROMPTS=1
NUM_WARMUPS=0
READY_CHECK_TIMEOUT_SEC=0
MAX_CONCURRENCY=1
REQUEST_RATE=1
IGNORE_EOS_FLAG=--ignore-eos
TEMPERATURE=0
BENCH_SEED=0

# 服务启动、退出和采集前后的等待参数，单位为秒。
READY_CHECK_ATTEMPTS=180
READY_CHECK_INTERVAL=2
SERVICE_SETTLE_SECONDS=2
PERF_SETTLE_SECONDS=1
SHUTDOWN_ATTEMPTS=30
SHUTDOWN_INTERVAL=1

# 热点每10万个用户态cycles采样一次；常驻采集使用Worker RPC确认的执行线程TID。
# 下列名称匹配仅用于不带session单独运行run_one.sh的原有流程。
HOTSPOT_WORKER_PATTERN="VLLM::Worker_TP"
PYTHON_PERF_SUPPORT=1
PERF_EVENT=cycles:u
PERF_PERIOD=100000
PERF_REPORT_FLAGS="--stdio --no-children"

# 920B原始PMU事件组。
EVENTS_920B_TOPDOWN=0x0011,0x0008,0x2011,0x2012,0x001b
EVENTS_920B_FLUSH=0x0011,0x0010,0x2010,0x104f,0x200f
EVENTS_920B_BADSPEC_BRANCH=0x0010,0x1010,0x1013,0x1016,0x100d
EVENTS_920B_BACKEND_CORE=0x0011,0x7001,0x7002,0x7003,0x7004
EVENTS_920B_BACKEND_MEMORY=0x0011,0x7005,0x7006,0x7007,0x7008,0x7009
EVENTS_920B_ICACHE=0x0008,0x0001,0x0014,0x0027,0x0028,0x0011
EVENTS_920B_DCACHE=0x0008,0x0003,0x0004,0x0017,0x0016
EVENTS_920B_L3=0x0008,0x002a,0x002b
EVENTS_920B_TLB1=0x0008,0x0002,0x0026,0x0005,0x0025
EVENTS_920B_TLB2=0x0008,0x002d,0x002e,0x002f,0x0030,0x0011
EVENTS_920B_BRANCH=0x0008,0x0021,0x0022
EVENTS_920B_IMIX=0x001b,0x0070,0x0073,0x8005,0x0078
EVENTS_920B_IMIX2=0x001b,0x0071,0x0079,0x007a,0x0075,0x8006

# 950原始PMU事件组。
EVENTS_950_TOPDOWN=0x0011,0x0008,0x1f21,0x1f22,0x001b
EVENTS_950_FRONTEND_DETAIL=0x0011,0x1f10,0x1f11,0x1f12,0x1f13,0x1f14
EVENTS_950_BADSPEC_BRANCH=0x0010,0x2010,0x1010,0x1013,0x1016,0x100d
EVENTS_950_BACKEND_CORE=0x0011,0x7000,0x7001,0x7002,0x7003,0x7004
EVENTS_950_BACKEND_MEMORY=0x0011,0x7005,0x7006,0x7007,0x7008,0x7009
EVENTS_950_ICACHE=0x0008,0x0001,0x0014,0x0027,0x0028
EVENTS_950_DCACHE=0x0008,0x0003,0x0004,0x0017,0x0016
EVENTS_950_L3=0x0008,0x002a,0x002b
EVENTS_950_TLB1=0x0008,0x0002,0x0026,0x0005,0x0025
EVENTS_950_TLB2=0x0008,0x002d,0x002e,0x002f,0x0030
EVENTS_950_BRANCH=0x0008,0x0021,0x0022,0x203f,0x2040
EVENTS_950_IMIX=0x001b,0x0070,0x0073,0x8005,0x0078
EVENTS_950_IMIX2=0x001b,0x0071,0x0079,0x007a,0x0075,0x8006

# Hygon C86 7490 Core PMU事件组和事件名称。
EVENTS_HYGON_TOPDOWN=0x76,0xc0,0xc1,0x03aa,0x0487
NAMES_HYGON_TOPDOWN=cycles,instructions,retired_uops,dispatched_uops,frontend_stall_any
EVENTS_HYGON_BRANCH=0xc0,0xc2,0xc3
NAMES_HYGON_BRANCH=instructions,branches,branch_misses
EVENTS_HYGON_SPEC_LS=0x03aa,0x0129,0x0229,0x0429,0xc2
NAMES_HYGON_SPEC_LS=dispatched_uops,load_ops,store_ops,load_store_ops,branches
EVENTS_HYGON_SPEC_ASE=0x03aa,0x0f00
NAMES_HYGON_SPEC_ASE=dispatched_uops,fpu_spec_uops
EVENTS_HYGON_ICACHE=0xc0,0x80,0x81,0x0764,0x0164
NAMES_HYGON_ICACHE=instructions,l1i_fetch_windows,l1i_miss_windows,l2i_accesses,l2i_misses
EVENTS_HYGON_DCACHE=0xc0,0x0729,0xc860,0x0864,0xf064
NAMES_HYGON_DCACHE=instructions,ls_ops,l1d_miss_proxy,l2d_misses,l2d_hits
EVENTS_HYGON_TLB=0xc0,0x0729,0xff45,0x0f45,0xf045
NAMES_HYGON_TLB=instructions,ls_ops,l1_dtlb_misses,stlb_hits,stlb_misses

# Zen1 candidate diagnostics; event behavior on Hygon 7490 remains unvalidated.
EVENTS_HYGON_BRANCH_DETAIL=0xc3,0xca,0xc9,0xc8
NAMES_HYGON_BRANCH_DETAIL=branch_misses,indirect_branch_misses,return_misses,returns
EVENTS_HYGON_FRONTEND_DETAIL=0x76,0x0287,0x0187
NAMES_HYGON_FRONTEND_DETAIL=cycles,ic_dq_empty,ic_backpressure
EVENTS_HYGON_BACKEND_DETAIL=0x76,0xd3,0x10af,0x08af,0x40af
NAMES_HYGON_BACKEND_DETAIL=cycles,div_busy,alu_token_stall,alsq_token_stall,retire_token_stall
EVENTS_HYGON_MEMORY_DETAIL=0x76,0x016d,0xc0,0x84,0x85
NAMES_HYGON_MEMORY_DETAIL=cycles,l2_fill_pending,instructions,itlb_l2_hit,itlb_l2_miss

# Hygon共享L3 Uncore PMU配置。
HYGON_L3_PMU_ROOT=/sys/bus/event_source/devices/amd_l3
HYGON_L3_PMU_NAME=amd_l3
EVENTS_HYGON_L3=0xff04,0x0106
NAMES_HYGON_L3=l3_accesses,l3_misses

# Explicit placement is opt-in; empty legacy configurations remain supported.
COLLECTION_PROFILE=${COLLECTION_PROFILE:-full} # full or end_to_end
PLACEMENT_MODE=${PLACEMENT_MODE:-legacy} # legacy or worker_set
WORKER_CPUS=${WORKER_CPUS:-}
WORKER_POOL_CPUS=${WORKER_POOL_CPUS:-} # four physical cores, one logical CPU each
WORKER_NUMA_NODE=${WORKER_NUMA_NODE:-}
SERVICE_CPUS=${SERVICE_CPUS:-}
CLIENT_CPUS=${CLIENT_CPUS:-}
# legacy retains old whole-Worker / persistent execution-thread hotspot defaults.
HOTSPOT_SCOPE=${HOTSPOT_SCOPE:-legacy} # legacy, thread, worker

# Optional independent DevKit inference round (supported Arm servers only).
FREQUENCY_ENABLE=${FREQUENCY_ENABLE:-0}
DEVKIT_BIN=${DEVKIT_BIN:-devkit}

# A trusted task-specific configuration overrides defaults without editing history.
SPE_ENABLE=${SPE_ENABLE:-auto} # main entry: enable for explicitly placed Arm runs
ROUND_WARMUPS=${ROUND_WARMUPS:-0}
WARMUP_SCOPE=${WARMUP_SCOPE:-per_group} # per_group or session
GROUP_START_TEMPERATURE=${GROUP_START_TEMPERATURE:-0} # 0 disables between-group cooling
if [[ -n ${TOPDOWN_CONFIG:-} ]]; then
    [[ "$TOPDOWN_CONFIG" != "${BASH_SOURCE[0]}" ]] || { printf 'Recursive config\n' >&2; exit 2; }
    source "$TOPDOWN_CONFIG"
fi
