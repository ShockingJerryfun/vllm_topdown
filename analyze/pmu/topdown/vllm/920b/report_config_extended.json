          "number_format": "0.00%",
          "formula": "=IFERROR({0x2012}/{0x0011},\"\")"
        },
        {
          "name": "fetch_bandwidth_bound",
          "number_format": "0.00%",
          "formula": "=IFERROR({frontend_bound}-{fetch_latency_bound},\"\")"
        },
        {
          "name": "bad_spec",
          "number_format": "0.00%",
          "formula": "=IFERROR(({0x001b}-{0x0008})/(6*{0x0011}),\"\")"
        },
        {
          "name": "backend_bound",
          "number_format": "0.00%",
          "formula": "=IFERROR(1-{retire}-{frontend_bound}-{bad_spec},\"\")"
        }
      ]
    },
