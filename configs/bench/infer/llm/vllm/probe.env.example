# 按实际环境填写；该文件由 adapters/vllm/run.sh 作为 shell 配置读取。
VLLM_SOURCE_ROOT=/path/to/instrumented-vllm-source
VLLM_SITE=/path/to/site-packages/vllm
PYTHON_BIN=/path/to/environment/bin/python
VLLM_BIN=/path/to/environment/bin/vllm
MODEL=/path/to/model
VLLM_VERSION=0.26.0
VLLM_VERSION_SHORT=0.26
MODEL_SHORT=qwen3
SERVED_MODEL=Qwen3_8B
SERVER_FLAGS=--no-async-scheduling
# 920b 或 zen4；默认配置保持 920b。
TOPDOWN_PMU_PROFILE=920b

# 根据实际拓扑和空闲情况填写，不要复用其他用户的 CPU。
PLACEMENT_MODE=worker_set
WORKER_CPUS=
WORKER_POOL_CPUS=
WORKER_NUMA_NODE=
# WORKER_CPU_NODE 未设置时与 WORKER_NUMA_NODE 相同。
API_CPUS=
ENGINE_CPUS=
SERVICE_CPUS=
CLIENT_CPUS=

GPU_ID=0
PORT=18026
RANDOM_INPUT_LEN=7000
RANDOM_OUTPUT_LEN=100
ANON_THP_MODE=off
COLLECTION_PROFILE=full
SPE_ENABLE=0
